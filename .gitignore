# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 키비주얼 원본 보관소(고화질 PNG) — 배포엔 public/images/news 최적화본만 사용
/blog/

# typescript
*.tsbuildinfo
next-env.d.ts

# 카운트다운 종료 후 되돌릴 원본 키비주얼 백업
/.keyvisual-backup/
